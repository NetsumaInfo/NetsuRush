{
  "about": "Upscale sizing table shared by test/upscale-plan.test.cjs (core/upscaleArgs.js) and test/test_upscale_plan.py (python/upscaler/plan.py). target = resolution class (0 = factor), native = network factor (0 = free-size engine, JS only). feed = what the network is given, out = what is written, resample = what happens after the network.",
  "cases": [
    { "name": "720p to 1080p, x2 overshoots then reduces", "src": [1280, 720], "target": 1080, "scale": 2, "native": 2, "feed": [1280, 720], "out": [1920, 1080], "resample": "down" },
    { "name": "720p to 1080p, x4 overshoots then reduces", "src": [1280, 720], "target": 1080, "scale": 2, "native": 4, "feed": [1280, 720], "out": [1920, 1080], "resample": "down" },
    { "name": "720p to 1440p, x2 lands exactly", "src": [1280, 720], "target": 1440, "scale": 2, "native": 2, "feed": [1280, 720], "out": [2560, 1440], "resample": "none" },
    { "name": "720p to 1440p, x4 overshoots then reduces", "src": [1280, 720], "target": 1440, "scale": 2, "native": 4, "feed": [1280, 720], "out": [2560, 1440], "resample": "down" },
    { "name": "720p to 2160p, x2 enlarges before the network", "src": [1280, 720], "target": 2160, "scale": 2, "native": 2, "feed": [1920, 1080], "out": [3840, 2160], "resample": "none" },
    { "name": "720p to 2160p, x4 overshoots then reduces", "src": [1280, 720], "target": 2160, "scale": 2, "native": 4, "feed": [1280, 720], "out": [3840, 2160], "resample": "down" },

    { "name": "1080p to 1080p, x2 is never a plain copy", "src": [1920, 1080], "target": 1080, "scale": 2, "native": 2, "feed": [1920, 1080], "out": [1920, 1080], "resample": "down" },
    { "name": "1080p to 1080p, x4 is never a plain copy", "src": [1920, 1080], "target": 1080, "scale": 2, "native": 4, "feed": [1920, 1080], "out": [1920, 1080], "resample": "down" },
    { "name": "1080p to 1440p, x2", "src": [1920, 1080], "target": 1440, "scale": 2, "native": 2, "feed": [1920, 1080], "out": [2560, 1440], "resample": "down" },
    { "name": "1080p to 2160p, x2 lands exactly", "src": [1920, 1080], "target": 2160, "scale": 2, "native": 2, "feed": [1920, 1080], "out": [3840, 2160], "resample": "none" },
    { "name": "1080p to 2160p, x4 is never fed below the source", "src": [1920, 1080], "target": 2160, "scale": 2, "native": 4, "feed": [1920, 1080], "out": [3840, 2160], "resample": "down" },

    { "name": "1440p to 1080p, fed at the 1080p cap", "src": [2560, 1440], "target": 1080, "scale": 2, "native": 2, "feed": [1920, 1080], "out": [1920, 1080], "resample": "down" },
    { "name": "1440p to 1440p, x4 fed at the cap", "src": [2560, 1440], "target": 1440, "scale": 2, "native": 4, "feed": [1920, 1080], "out": [2560, 1440], "resample": "down" },
    { "name": "1440p to 2160p, x2 from the cap lands exactly", "src": [2560, 1440], "target": 2160, "scale": 2, "native": 2, "feed": [1920, 1080], "out": [3840, 2160], "resample": "none" },

    { "name": "2160p to 2160p, x2 from the cap lands exactly", "src": [3840, 2160], "target": 2160, "scale": 2, "native": 2, "feed": [1920, 1080], "out": [3840, 2160], "resample": "none" },
    { "name": "2160p to 2160p, x4 from the cap reduces", "src": [3840, 2160], "target": 2160, "scale": 2, "native": 4, "feed": [1920, 1080], "out": [3840, 2160], "resample": "down" },
    { "name": "2160p to 1080p, x4 from the cap reduces", "src": [3840, 2160], "target": 1080, "scale": 2, "native": 4, "feed": [1920, 1080], "out": [1920, 1080], "resample": "down" },

    { "name": "480p to 1080p, x2 enlarges before the network", "src": [854, 480], "target": 1080, "scale": 2, "native": 2, "feed": [960, 540], "out": [1920, 1078], "resample": "down" },
    { "name": "480p to 1080p, x4 overshoots then reduces", "src": [854, 480], "target": 1080, "scale": 2, "native": 4, "feed": [854, 480], "out": [1920, 1078], "resample": "down" },
    { "name": "480p to 2160p, x2 enlarges before the network", "src": [854, 480], "target": 2160, "scale": 2, "native": 2, "feed": [1920, 1080], "out": [3840, 2158], "resample": "down" },
