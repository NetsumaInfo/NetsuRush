# NetsuRush — variables renderer (Vite). Copie ce fichier en `.env.local` puis remplis.
# Fournies par `npx convex dev` (voir AUTH_SETUP.md). NE PAS committer `.env.local`.

# URL du déploiement Convex (WebSocket réactif) — se termine par .convex.cloud
VITE_CONVEX_URL=

# URL du site Convex (routes HTTP Better Auth) — se termine par .convex.site
VITE_CONVEX_SITE_URL=
