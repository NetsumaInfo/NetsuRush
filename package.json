{
  "name": "netsurush",
  "private": true,
  "version": "0.3.7",
  "license": "AGPL-3.0-only",
  "author": "Haim Faraj",
  "repository": {
    "type": "git",
    "url": "https://github.com/NetsumaInfo/NetsuRush.git"
  },
  "bugs": {
    "url": "https://github.com/NetsumaInfo/NetsuRush/issues"
  },
  "homepage": "https://github.com/NetsumaInfo/NetsuRush#readme",
  "type": "module",
  "description": "NetsuRush — app DaVinci Resolve standalone (Tauri + core Node) : derush IA, preview rush, découpe frame-accurate",
  "main": "core/server.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "core": "node core/server.js",
    "check:core": "tsc -p tsconfig.core.json",
    "test:hardware": "node --test test/hardware.test.cjs",
    "test:preview": "node --test test/preview-generation.test.cjs",
    "test:config-backend": "node --test test/config-backend.test.cjs",
    "test:python-device": "python -m unittest discover -s test -p test_nrdevice.py",
    "test:python-codecs": "python -m unittest discover -s test -p test_codecs.py",
    "test:roto-matte": "python -m unittest discover -s test -p test_roto_matte.py",
    "test:python-search": "python -m unittest discover -s test -p \"test_search_*.py\"",
    "test:search-mentions": "node --test test/search-mentions.test.cjs",
    "test:adaptive-codec": "node --test test/adaptive-codec.test.cjs",
    "test:packaging": "node --test test/packaging.test.cjs",
    "test:venv-families": "node --test test/venv-families.test.cjs",
    "test:setup": "node --test test/setup-selection.test.cjs",
    "test:export-gate": "node --test test/export-gate.test.cjs",
    "test:export-naming": "node --test test/export-naming.test.cjs",
    "test:bug-report": "node --test test/bug-report.test.cjs",
    "test:watchdog": "node --test test/optimize-watchdog.test.cjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "update:manifest": "node scripts/create-update-manifest.mjs",
    "tauri": "tauri",
    "test:adobe-panel": "node --test test/adobe-panel-update.test.cjs",
    "test:transfer": "node --test test/transfer-doc.test.cjs test/transfer-place-jsx.test.cjs test/transfer-encoding.test.cjs test/transfer-xmeml-graphics.test.cjs test/transfer-xmeml-audio.test.cjs",
    "test:netsu": "node --test test/netsu-levels.test.cjs test/netsu-file.test.cjs test/netsu-project.test.cjs test/netsu-notebook.test.cjs",
    "test:wallpaper": "node --test test/wallpaper.test.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@blocknote/code-block": "^0.51.4",
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@convex-dev/better-auth": "^0.12.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@number-flow/react": "^0.6.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/extension-drag-handle-react": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.1",
    "dictionary-en": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.6",
    "katex": "^0.17.0",
    "lucide-react": "^0.460.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-data-grid": "^7.0.0-beta.59",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.9",
    "shadcn": "^4.11.0",
    "simple-icons": "^16.24.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
