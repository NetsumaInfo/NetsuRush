src-tauri/resources/shaders/
# Native player runtime (libmpv + sibling ffmpeg/libplacebo DLLs, ~51 MB, mpv GPL-2.0+).
# build.ps1 provisions it from vendor/mpv, which scripts/fetch-mpv.ps1 rebuilds.
src-tauri/resources/windows/

